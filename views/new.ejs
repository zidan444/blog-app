<%- include('partials/header') %>

<div class="container my-5" style="max-width: 720px;">
  <div class="glass-card">
    <div class="mb-4">
      <h2 class="fw-bold mb-1" style="font-family: 'Newsreader', serif; font-size: 2rem;">Write New Story</h2>
      <p class="text-secondary" style="font-size: 0.9rem;">Share your thoughts and ideas with readers.</p>
    </div>

    <form id="blogForm">
      <!-- Title -->
      <div class="mb-4">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="title" id="title" class="form-control" placeholder="Enter story title..." required>
      </div>

      <!-- Categories -->
      <div class="mb-4">
        <label for="categories" class="form-label">Topics / Categories</label>
        <input type="text" name="categories" id="categories" class="form-control" placeholder="Comma separated, e.g. Tech, Design, Tutorial">
      </div>

      <!-- Image Upload -->
      <div class="mb-4">
        <label for="image" class="form-label">Cover Image (Optional)</label>
        <input type="file" id="image" class="form-control" accept="image/*">
        <input type="hidden" name="image" id="imageUrl">
        <div id="preview" class="mt-3"></div>
      </div>

      <!-- Content -->
      <div class="mb-4">
        <label for="content" class="form-label">Content Body</label>
        <textarea name="content" id="content" rows="10" class="form-control" placeholder="Write your full story here..." required></textarea>
      </div>

      <div class="d-flex align-items-center justify-content-between pt-3 border-top border-secondary">
        <a href="/" class="btn btn-outline-custom">Cancel</a>
        <button type="submit" id="submitBtn" class="btn btn-minimal">
          Publish Post
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

<script>
const blogForm = document.getElementById('blogForm');
const imageInput = document.getElementById('image');
const previewDiv = document.getElementById('preview');
const imageUrlInput = document.getElementById('imageUrl');
const submitBtn = document.getElementById('submitBtn');

imageInput.addEventListener('change', () => {
  if (imageInput.files.length) {
    const file = imageInput.files[0];
    const reader = new FileReader();
    reader.onload = (e) => {
      previewDiv.innerHTML = `
        <div class="position-relative d-inline-block">
          <img src="${e.target.result}" style="max-height:180px; border-radius:8px; object-fit:cover;" class="border border-secondary">
        </div>
      `;
    };
    reader.readAsDataURL(file);
  }
});

blogForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  submitBtn.disabled = true;
  submitBtn.innerHTML = 'Publishing...';

  try {
    if (imageInput.files.length) {
      const formData = new FormData();
      formData.append('image', imageInput.files[0]);

      const res = await fetch('/api/upload', { method: 'POST', body: formData });
      const data = await res.json();

      if (res.ok) {
        imageUrlInput.value = data.url;
      }
    }

    const payload = {
      title: document.getElementById('title').value,
      content: document.getElementById('content').value,
      categories: document.getElementById('categories').value,
      image: imageUrlInput.value
    };

    const postRes = await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (postRes.ok) {
      window.location.href = '/';
    } else {
      alert('Failed to publish story.');
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Publish Post';
    }
  } catch (err) {
    console.error(err);
    alert('An error occurred.');
    submitBtn.disabled = false;
    submitBtn.innerHTML = 'Publish Post';
  }
});
</script>


