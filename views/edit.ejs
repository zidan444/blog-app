<%- include('partials/header') %>

<div class="container my-5" style="max-width: 720px;">
  <div class="glass-card">
    <div class="mb-4">
      <h2 class="fw-bold mb-1" style="font-family: 'Newsreader', serif; font-size: 2rem;">Edit Story</h2>
      <p class="text-secondary" style="font-size: 0.9rem;">Update your story content.</p>
    </div>

    <form action="/<%= blog._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
      <!-- Title -->
      <div class="mb-4">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="title" id="title" class="form-control" value="<%= blog.title %>" required>
      </div>

      <!-- Categories -->
      <div class="mb-4">
        <label for="categories" class="form-label">Topics / Categories</label>
        <input type="text" name="categories" id="categories" class="form-control" value="<%= blog.categories ? blog.categories.join(', ') : '' %>" placeholder="Comma separated, e.g. Tech, Design">
      </div>

      <!-- Image Upload -->
      <div class="mb-4">
        <label for="image" class="form-label">Change Cover Image (Optional)</label>
        <input type="file" name="image" id="image" class="form-control" accept="image/*">
        <% if (blog.image) { %>
          <div class="mt-3">
            <span class="d-block text-secondary text-sm mb-1">Current Image:</span>
            <img src="<%= blog.image %>" class="img-fluid rounded border border-secondary" style="max-height: 160px; object-fit: cover;" alt="Current cover image">
          </div>
        <% } %>
      </div>

      <!-- Content -->
      <div class="mb-4">
        <label for="content" class="form-label">Content Body</label>
        <textarea name="content" id="content" rows="10" class="form-control" required><%= blog.content %></textarea>
      </div>

      <div class="d-flex align-items-center justify-content-between pt-3 border-top border-secondary">
        <a href="/<%= blog._id %>" class="btn btn-outline-custom">Cancel</a>
        <button type="submit" class="btn btn-minimal">
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>


