<%- include('partials/header') %>

<div class="container my-5" style="max-width: 420px;">
  <div class="glass-card">
    <div class="text-center mb-4">
      <h2 class="fw-bold mb-1" style="font-family: 'Newsreader', serif; font-size: 2rem;">Log In</h2>
      <p class="text-secondary" style="font-size: 0.9rem;">Welcome back. Log in to your account.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-dark border border-danger text-danger text-center mb-4 py-2" style="font-size: 0.875rem;">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" name="email" id="email" required class="form-control" placeholder="name@example.com">
      </div>

      <div class="mb-4">
        <label for="password" class="form-label">Password</label>
        <input type="password" name="password" id="password" required class="form-control" placeholder="••••••••">
      </div>

      <button type="submit" class="btn btn-minimal w-100 py-2">
        Log In
      </button>
    </form>

    <div class="mt-4 pt-3 border-top border-secondary text-center" style="font-size: 0.875rem;">
      <span class="text-secondary">Don't have an account yet?</span>
      <a href="/signup" class="fw-bold text-white ms-1">Sign Up</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>


